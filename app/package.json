{
  "name": "dekanat-v-karmane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Деканат в кармане: концепт личного кабинета студента для конкурса. Вымышленные данные.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/with-env.mjs ./node_modules/next/dist/bin/next dev",
    "build": "node scripts/with-env.mjs ./node_modules/next/dist/bin/next build",
    "start": "node scripts/with-env.mjs ./node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/with-env.mjs ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "npm run db:seed && npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "screenshots": "npm run db:seed && npm run build && node ./node_modules/tsx/dist/cli.mjs tests/e2e/screenshots.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "playwright:install": "playwright install chromium",
    "db:setup": "node db/setup-local.mjs",
    "db:generate": "node ./node_modules/drizzle-kit/bin.cjs generate --config=db/drizzle.config.ts",
    "db:migrate": "node scripts/with-env.mjs ./node_modules/tsx/dist/cli.mjs db/migrate.ts",
    "db:seed": "node scripts/with-env.mjs ./node_modules/tsx/dist/cli.mjs db/seed.ts",
    "db:refresh": "node scripts/with-env.mjs ./node_modules/tsx/dist/cli.mjs db/seed-refresh.ts",
    "db:seed:reserve": "node scripts/with-env.mjs ./node_modules/tsx/dist/cli.mjs db/seed-reserve.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
