# Образец файла окружения. Скопируйте в .env в корне репозитория и заполните. Один файл на всё: в app/ файлов .env* нет.
# Локально .env создаёт скрипт: cd app && npm run db:setup (значения не печатаются). Файл .env в git не попадает.
# Значения здесь не пишутся: только имена и пояснения. Секреты не получают имя с NEXT_PUBLIC_.

# Строка подключения роли приложения (без прав суперпользователя). Единственное, что видит контейнер приложения.
DATABASE_URL=
# Строка подключения владельца базы: миграции и вымышленные данные. Приложению не передаётся.
DATABASE_OWNER_URL=
# То же для отдельной тестовой базы (имя заканчивается на _test): модульные тесты слоя доступа.
TEST_DATABASE_URL=
TEST_DATABASE_OWNER_URL=
# Резервные наборы для жюри (npm run db:seed:reserve): логин и пароль сотрудника и двух студентов, по набору 1 и 2.
# Пароль — случайная строка не короче 20 знаков; логины латиницей, не совпадают с логинами основного набора и друг с другом.
# Нет переменной или пароль короче 20 знаков — команда отказывает и ничего не пишет. Значения в репозитории не лежат.
RESERVE_1_STAFF_LOGIN=
RESERVE_1_STAFF_PASSWORD=
RESERVE_1_STUDENT_1_LOGIN=
RESERVE_1_STUDENT_1_PASSWORD=
RESERVE_1_STUDENT_2_LOGIN=
RESERVE_1_STUDENT_2_PASSWORD=
RESERVE_2_STAFF_LOGIN=
RESERVE_2_STAFF_PASSWORD=
RESERVE_2_STUDENT_1_LOGIN=
RESERVE_2_STUDENT_1_PASSWORD=
RESERVE_2_STUDENT_2_LOGIN=
RESERVE_2_STUDENT_2_PASSWORD=
# Пароль владельца базы: нужен только базе и миграциям (Compose на сервере).
POSTGRES_OWNER_PASSWORD=
# Пароль роли приложения: нужен базе при создании роли и строке подключения приложения (Compose на сервере).
POSTGRES_APP_PASSWORD=
# Имя заголовка, в котором обратный прокси передаёт адрес посетителя (например x-real-ip). Пусто — заголовка нет, адрес «unknown».
# На сервере с прокси из compose.proxy.yaml — x-real-ip.
CLIENT_IP_HEADER=
# Только сервер: имя сайта для обратного прокси и сертификата, без https:// (compose.proxy.yaml, deploy/Caddyfile).
SITE_ADDRESS=
# Только сервер: какие файлы Compose берут команды docker compose. Значение: compose.yaml:compose.proxy.yaml
COMPOSE_FILE=
# Часовой пояс вуза: от него зависят «сегодня» и сроки. По умолчанию Europe/Moscow.
APP_TIMEZONE=
# Размер пула соединений приложения с базой. По умолчанию 10.
DB_POOL_MAX=
# 1 — не отправлять анонимную телеметрию Next.js.
NEXT_TELEMETRY_DISABLED=
